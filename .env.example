GEMINI_API_KEY=

# Amazon Bedrock (bearer-token / API key auth) - used by Chat Sesi 10
# Note: botocore/bedrock reads AWS_BEARER_TOKEN_BEDROCK (signing-name suffix),
# while Node/Next.js reads AWS_BEARER_TOKEN. Set both locally if using FastAPI too.
AWS_BEARER_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
MODEL_ID=amazon.nova-lite-v1:0

# PostgreSQL (hosted, e.g. Neon / Vercel Postgres / Supabase).
# local example: postgresql://postgres:123@localhost:5432/kelana_ai
DATABASE_URL=
