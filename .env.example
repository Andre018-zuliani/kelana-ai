# Salin file ini menjadi .env, lalu sesuaikan dengan kredensial PostgreSQL Anda.
# JANGAN commit file .env yang asli (sudah di-gitignore).

DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/kelana_ai

# Amazon Bedrock (Sesi 5) — API Key disediakan oleh instruktur.
AWS_BEARER_TOKEN_BEDROCK=sk-bedrock-xxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0
